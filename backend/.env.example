# Backend configuration (all optional). Copy to .env or export before running.

# Network binding
HOST=0.0.0.0
PORT=8000

# Writable data locations (override for containers / read-only installs)
# VA_DATA_DIR=/var/lib/voice-assistant
# VA_MODELS_DIR=/var/lib/voice-assistant/models
# VA_DB_PATH=/var/lib/voice-assistant/assistant.db

# CORS allowlist (comma-separated). Default "*". Set explicit origins in production.
# VA_CORS_ORIGINS=https://app.example.com,http://localhost:8081

# Offline Whisper model size for faster-whisper (tiny|base|small|medium|large-v3)
VA_WHISPER_MODEL=base

# Dev auto-reload (never enable in production)
VA_RELOAD=false

# Optional cloud LLM fallback (leave empty to stay fully offline)
GEMINI_API_KEY=
OPENAI_API_KEY=
