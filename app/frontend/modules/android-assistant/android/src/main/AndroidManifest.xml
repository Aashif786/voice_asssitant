<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.READ_CONTACTS" />
  <uses-permission android:name="android.permission.CALL_PHONE" />
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
  <uses-permission android:name="android.permission.SET_ALARM" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <service
        android:name=".AssistantForegroundService"
        android:exported="false"
        android:foregroundServiceType="microphone" />

    <service
        android:name=".AssistantVoiceInteractionService"
        android:permission="android.permission.BIND_VOICE_INTERACTION"
        android:exported="true">
        <meta-data
            android:name="android.voice_interaction"
            android:resource="@xml/voice_interaction_service" />
        <intent-filter>
            <action android:name="android.service.voice.VoiceInteractionService" />
        </intent-filter>
    </service>

    <service
        android:name=".AssistantVoiceInteractionSessionService"
        android:permission="android.permission.BIND_VOICE_INTERACTION"
        android:exported="true" />

    <service
        android:name=".AssistantRecognitionService"
        android:permission="android.permission.BIND_RECOGNITION_SERVICE"
        android:exported="true">
        <intent-filter>
            <action android:name="android.speech.RecognitionService" />
            <category android:name="android.intent.category.DEFAULT" />
        </intent-filter>
    </service>

    <service
        android:name=".AssistantNotificationListener"
        android:label="Handsfree Assistant Notification Listener"
        android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
        android:exported="true">
        <intent-filter>
            <action android:name="android.service.notification.NotificationListenerService" />
        </intent-filter>
    </service>
  </application>
</manifest>
