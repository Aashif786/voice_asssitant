# ==========================================
# Application Data & Local Runtime
# ==========================================
# Ignore local SQLite databases and temp write-ahead logs
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
*.db
*.sqlite3

# Ignore heavy downloaded AI model files (GGUF, bin, weights)
backend/data/models/*
!backend/data/models/.gitkeep
!backend/data/.gitkeep

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
!.env.example

